# DataSport backend — copy to .env and fill in values

DATA_BACKEND=duckdb
STAGING_DATA_DIR=

# Analyst pipeline: router (default) | legacy
INTERPRETER_PIPELINE=router

# OpenAI (router + analyst when provider=openai)
OPENAI_API_KEY=
# Default https://api.openai.com/v1 — use https://us.api.openai.com/v1 only for US-region keys
OPENAI_BASE_URL=

# Anthropic (optional — set provider to anthropic)
ANTHROPIC_API_KEY=

# Router (Call 1 — JSON table plan, no SQL)
ROUTER_PROVIDER=openai
ROUTER_MODEL=gpt-5.4-mini
ROUTER_MAX_TOKENS=1500
ROUTER_MAX_TABLE_REQUESTS=8

# Analyst (Call 2 — multi-table narrative)
ANALYST_PROVIDER=openai
ANALYST_MODEL=gpt-5.4-mini
ANALYST_MAX_TOKENS=2000
ANALYST_BUNDLE_CHAR_CAP=48000
ANALYST_BUNDLE_ROW_CAP=5

# Legacy SQL LLM path (INTERPRETER_PIPELINE=legacy)
STAGING_SQL_MODEL=gpt-5.4-mini
CONTEXT_RESOLVER_MODEL=gpt-5.4-mini

# Debug
ANALYSIS_DEBUG=1
LOG_LEVEL=INFO

# Legacy PostgreSQL (only if DATA_BACKEND=postgres)
POSTGRES_HOST=
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=

# Firebase (optional — chat history auth)
FIREBASE_API_KEY=
