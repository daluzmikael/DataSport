# Copy to .env.local for local development. On Vercel these are set as
# Environment Variables in the project settings instead.

# Base URL of the Render API. No trailing slash.
# Local:      http://localhost:8000
# Production: https://datasport-api.onrender.com
NEXT_PUBLIC_API_URL=http://localhost:8000

# Firebase Web API key for signup/login and saved chat history.
NEXT_PUBLIC_FIREBASE_API_KEY=
